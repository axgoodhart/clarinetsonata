  box-shadow: 0 0 6px rgba(123, 97, 255, 0.4);
}
.seg-slider.end::-webkit-slider-thumb {
  background: #57e0a0;
  box-shadow: 0 0 6px rgba(87, 224, 160, 0.4);
}
.seg-slider::-webkit-slider-thumb:hover {
  transform: scale(1.3);
}

/* Drift & Palette controls */
.seg-drift-controls {
  display: flex;
  gap: 8px;
}
.seg-drift-side {
  flex: 1;
  display: flex;
  gap: 4px;
}

.seg-palette-controls {
  display: flex;
  gap: 8px;
}

.seg-select {
  flex: 1;
  background: rgba(11, 15, 22, 0.8);
  border: 1px solid rgba(100, 116, 139, 0.15);
  color: #94a3b8;
  border-radius: 5px;
  padding: 4px 6px;
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 10px;
  outline: none;
  cursor: pointer;
}
.seg-select:focus {
  border-color: rgba(6, 182, 212, 0.4);
}

/* Mode toggle button */
.seg-mode-toggle {
  flex-shrink: 0;
  margin-top: auto;
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(4px);
  border: none;
  border-top: 1px solid rgba(100, 116, 139, 0.1);
  color: #475569;
  font-family: "Berkeley Mono", "SF Mono", "Fira Code", monospace;
  font-size: 13px;
  letter-spacing: 0.04em;
  cursor: pointer;
  transition: color 0.15s, background 0.15s;
  text-align: center;
  line-height: 1.4;
  border-radius:40px;
}
.seg-mode-toggle:hover {
  color: #94a3b8;
  background: rgba(255, 255, 255, 0.05);
}

/* ── App Layout ──────────────────────────── */
.app-container {
  width: 100%;
  height: 100vh;
  background: #030712;
  position: relative;
  overflow: hidden;
}
.app-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* ── Drop Zone ──────────────────────────── */
.drop-zone {
  position: absolute;
  inset: 0;
  background: rgba(59, 130, 246, 0.1);
  border: 2px dashed rgba(96, 165, 250, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 30;
  pointer-events: none;
}
.drop-zone-text {
  color: rgba(147, 197, 253, 0.7);
  font-size: 1.125rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

/* ── Controls Bar ──────────────────────── */
.controls-bar {
  position: absolute;
  bottom: 1rem;
  left: 1.5rem;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  width:90%;
  transition: transform 0.3s ease;
}
.controls-bar.edit-mode {
  z-index:1000;
}
.controls-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ── Scrub Slider ──────────────────────── */
.scrub-slider {
  width: 100%;
  height: 4px;
  appearance: none;
  background: #1e293b;
  border-radius: 9999px;
  cursor: pointer;
}
.scrub-slider::-webkit-slider-thumb {
  appearance: none;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #64748b;
  transition: background 0.15s;
}
.scrub-slider::-webkit-slider-thumb:hover {
  background: #cbd5e1;
}
.scrub-slider::-moz-range-thumb {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #64748b;
  border: 0;
}
.scrub-slider::-moz-range-thumb:hover {
  background: #cbd5e1;
}

/* ── Control Buttons ──────────────────── */
.control-btn {
  background: none;
  border: none;
  color: #64748b;
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  cursor: pointer;
  transition: color 0.15s;
  font-family: inherit;
}
.control-btn:hover {
  color: #cbd5e1;
}
.generate-btn {
  color: #155e75;
}
.generate-btn:hover {
  color: #22d3ee;
}
.demo-btn.active {
  color: #22d3ee;
}
.status-text {
  color: #334155;
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

/* ── Center buttons group ──────────── */
.controls-center {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

/* ── Waveform ──────────────────────────── */
.waveform-container {
  width: 100%;
  height: 60px;
}
.waveform-canvas {
  width: 100%;
  height: 60px;
  display: block;
  cursor: pointer;
}

/* ── Generate Modal ───────────────────────────── */

.gen-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(6px);
}

.gen-modal {
  width: 420px;
  max-height: 80vh;
  background: rgba(8, 12, 24, 0.95);
  border: 1px solid rgba(100, 116, 139, 0.2);
  border-radius: 10px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.gen-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  border-bottom: 1px solid rgba(100, 116, 139, 0.12);
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #94a3b8;
}

.gen-modal-close {
  background: none;
  border: none;
  color: #475569;
  font-size: 18px;
  cursor: pointer;
  padding: 0 4px;
  line-height: 1;
  transition: color 0.15s;
}
.gen-modal-close:hover { color: #e2e8f0; }

.gen-modal-body {
  padding: 14px 18px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.gen-row {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.gen-label {
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #64748b;
}

.gen-hint {
  font-size: 9px;
  color: #334155;
  letter-spacing: 0.1em;
  text-align: right;
}

.gen-slider-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.gen-range-pair {
  display: flex;
  gap: 12px;
}

.gen-range-half {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 6px;
}

.gen-range-tag {
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 8px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #334155;
  width: 22px;
  flex-shrink: 0;
}

.gen-slider {
  flex: 1;
  height: 3px;
  appearance: none;
  background: #1e293b;
  border-radius: 2px;
  cursor: pointer;
  outline: none;
}
.gen-slider::-webkit-slider-thumb {
  appearance: none;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #475569;
  transition: background 0.15s;
}
.gen-slider::-webkit-slider-thumb:hover {
  background: #94a3b8;
}

.gen-val {
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 10px;
  color: #64748b;
  width: 36px;
  text-align: right;
  flex-shrink: 0;
}

.gen-divider {
  height: 1px;
  background: rgba(100, 116, 139, 0.1);
  margin: 4px 0;
}

.gen-modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  padding: 12px 18px;
  border-top: 1px solid rgba(100, 116, 139, 0.12);
}

.gen-btn {
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 6px 16px;
  border-radius: 4px;
  border: 1px solid transparent;
  cursor: pointer;
  transition: all 0.15s;
}

.gen-btn-reset {
  background: transparent;
  color: #475569;
  border-color: rgba(100, 116, 139, 0.15);
}
.gen-btn-reset:hover {
  color: #94a3b8;
  border-color: rgba(100, 116, 139, 0.3);
}

.gen-btn-run {
  background: rgba(6, 182, 212, 0.12);
  color: #22d3ee;
  border-color: rgba(6, 182, 212, 0.25);
}
.gen-btn-run:hover {
  background: rgba(6, 182, 212, 0.2);
}
.gen-btn-run:disabled {
  opacity: 0.4;
  cursor: default;
}

/* ── XY Pad ───────────────────────────── */

.gen-xy-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}

.gen-xy-pad {
  width: 160px;
  height: 160px;
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(100, 116, 139, 0.2);
  border-radius: 6px;
  position: relative;
  cursor: crosshair;
  touch-action: none;
}

.gen-xy-pad::before,
.gen-xy-pad::after {
  content: "";
  position: absolute;
  background: rgba(100, 116, 139, 0.08);
}

.gen-xy-pad::before {
  left: 50%;
  top: 0;
  bottom: 0;
  width: 1px;
}

.gen-xy-pad::after {
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
}

.gen-xy-dot {
  position: absolute;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #22d3ee;
  box-shadow: 0 0 8px rgba(6, 182, 212, 0.4);
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.gen-xy-labels {
  display: flex;
  justify-content: space-between;
  width: 160px;
  user-select:none;
}

.gen-xy-label {
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 9px;
  user-select:none;
  letter-spacing: 0.1em;
  color: #475569;
}

.gen-xy-axis-label {
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 8px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  user-select:none;
  color: #334155;
  position: absolute;
}

.gen-xy-axis-x {
  bottom: -14px;
  left: 50%;
  transform: translateX(-50%);
}

.gen-xy-axis-y {
  left: -30px;
  top: 50%;
  transform: translateY(-50%) rotate(-90deg);
}

/* ── Master Slider ───────────────────────────── */

.gen-master-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.gen-master-label {
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #64748b;
  width: 52px;
  flex-shrink: 0;
}

/* ── Hitpoint Panel ───────────────────────────── */

.gen-hp-panel {
  position: fixed;
  z-index: 51;
  top: 50%;
  transform: translateY(-50%);
  right: calc(50% + 230px);
  width: 340px;
  background: rgba(8, 12, 24, 0.95);
  border: 1px solid rgba(100, 116, 139, 0.2);
  border-radius: 10px;
  padding: 14px 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.gen-hp-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gen-hp-title {
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #94a3b8;
}

.gen-hp-note {
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 9px;
  color: #475569;
}

.gen-hp-toggle {
  position: relative;
  width: 36px;
  height: 18px;
  background: rgba(30, 41, 59, 0.8);
  border: 1px solid rgba(100, 116, 139, 0.2);
  border-radius: 9px;
  cursor: pointer;
  transition: background 0.2s;
}

.gen-hp-toggle.on {
  background: rgba(6, 182, 212, 0.25);
  border-color: rgba(6, 182, 212, 0.4);
}

.gen-hp-toggle-dot {
  position: absolute;
  top: 2px;
  left: 2px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #475569;
  transition: all 0.2s;
}

.gen-hp-toggle.on .gen-hp-toggle-dot {
  left: 20px;
  background: #22d3ee;
}

.gen-hp-slider-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.gen-hp-slider-label {
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 14px;
  color: #475569;
  width: 14px;
  text-align: center;
  flex-shrink: 0;
}

.gen-hp-nav {
  display: flex;
  justify-content: center;
  gap: 8px;
}

.gen-hp-nav-btn {
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 4px 14px;
  border-radius: 4px;
  border: 1px solid rgba(100, 116, 139, 0.2);
  cursor: pointer;
  transition: all 0.15s;
  background: transparent;
  color: #94a3b8;
}

.gen-hp-nav-btn:hover {
  border-color: rgba(100, 116, 139, 0.4);
  color: #e2e8f0;
}

.gen-hp-nav-btn.last {
  background: rgba(244, 114, 182, 0.12);
  color: #f472b6;
  border-color: rgba(244, 114, 182, 0.25);
}

.gen-hp-nav-btn.last:hover {
  background: rgba(244, 114, 182, 0.2);
}

.gen-hp-mode-row {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.03);
  padding: 4px 10px;
  border-radius: 6px;
  border: 1px solid rgba(100, 116, 139, 0.08);
}

.gen-hp-mode-label {
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 8px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #475569;
  width: 40px;
}

.gen-hp-mode-btn {
  flex: 1;
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 9px;
  letter-spacing: 0.05em;
  padding: 3px 0;
  border: 1px solid rgba(100, 116, 139, 0.12);
  border-radius: 4px;
  background: transparent;
  color: #64748b;
  cursor: pointer;
  transition: all 0.15s;
}

.gen-hp-mode-btn:hover {
  border-color: rgba(100, 116, 139, 0.3);
  color: #94a3b8;
}

.gen-hp-mode-btn.active {
  background: rgba(6, 182, 212, 0.08);
  border-color: rgba(6, 182, 212, 0.3);
  color: #22d3ee;
}

/* ── Draw Mode ───────────────────────────── */

.draw-mode {
  position: absolute;
  inset: 0;
  z-index: 18;
  display: flex;
  pointer-events: auto;
  transform:scale(.7);
  border-radius:40px;
  overflow:hidden;
  border:1px solid cyan;
  box-shadow:inset 0 0 60px teal, 0 0 90px rgba(0, 191, 255, 0.581);
  backdrop-filter: blur(6px)brightness(.5);

}

/* Left param panel */
.draw-param-panel {
  width: 200px;
  flex-shrink: 0;
  display: flex;
  background:rgba(0,0,0,.4);
  flex-direction: column;
  padding: 16px 0;
  border-right:1px dashed rgba(0,150,150,.5);;
  border-radius: 0 0 0 40px;
}
.draw-mode-label {
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 10px;
  letter-spacing: 0.2em;
  color: #64748b;
  padding: 0 20px 14px;
  border-bottom: 1px solid rgba(100, 116, 139, 0.08);
  margin-bottom: 8px;
}
.draw-param-list {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 0 10px;
}
.draw-param-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border: none;
  background: transparent;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.15s;
  color: #475569;
  font-family: "SF Mono", "Fira Code", monospace;
}
.draw-param-item:hover {
  background: rgba(255, 255, 255, 0.03);
  color: #94a3b8;
}
.draw-param-item.active {
  color: var(--param-color, #22d3ee);
  background: color-mix(in srgb, var(--param-color, #22d3ee) 6%, transparent);
}
.draw-param-name {
  font-size: 12px;
  font-weight: 600;
  flex: 1;
  text-align: left;
}
.draw-param-val {
  font-size: 11px;
  opacity: 0.7;
  min-width: 28px;
  text-align: right;
}
.draw-param-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--param-color, #22d3ee);
  flex-shrink: 0;
  box-shadow: 0 0 6px var(--param-color, #22d3ee);
}

/* Center area */
.draw-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  position: relative;
}

/* Preview */
.draw-preview-wrap {
  position: relative;
  margin: 16px 16px 0 16px;
  flex-shrink: 0;
}
.draw-preview-label {
  position: absolute;
  top: -14px;
  left: 4px;
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 9px;
  letter-spacing: 0.1em;
  color: #475569;
}
.draw-preview {
  height: 200px;
  border: 1px solid rgba(244, 114, 182, 0.4);
  border-radius: 30px;
  filter:brightness(2)grayscale(.7);;
  overflow: hidden;
  mix-blend-mode:difference;
}
.draw-preview-canvas {
  width: 100%;
  height: 100%;
  display: block;
  
}

/* Stats */
.draw-stats {
  display: flex;
  justify-content: flex-end;
  gap: 24px;
  padding: 8px 20px 4px;
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 10px;
  color: #475569;
  letter-spacing: 0.05em;
}

/* Curve graph */
.draw-graph-wrap {
  flex: 1;
  margin: 4px 16px 80px 16px;
  position: relative;
  min-height: 0;
  
}
.draw-graph-canvas {
  width: 100%;
  height: 100%;
  display: block;
  cursor: crosshair;
  border-radius: 4px;
}

/* Axis labels */
.draw-axis-label {
  position: absolute;
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 13px;
  letter-spacing: 0.08em;
  pointer-events: none;
  user-select: none;
}
.draw-axis-high {
  top: 8px;
  right: 12px;
}
.draw-axis-low {
  bottom: 8px;
  right: 12px;
}

/* ── Palette Picker ──────────────────────── */
.draw-palette-picker {
  padding: 12px 16px;
  border-top: 1px solid rgba(100, 116, 139, 0.08);
  margin-top: auto;
}
.draw-palette-label {
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 9px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #475569;
  display: block;
  margin-bottom: 6px;
}
.draw-palette-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.draw-palette-arrow {
  background: none;
  border: none;
  color: #475569;
  font-size: 14px;
  cursor: pointer;
  padding: 2px 6px;
  transition: color 0.15s;
  font-family: "SF Mono", "Fira Code", monospace;
}
.draw-palette-arrow:hover { color: #cbd5e1; }
.draw-palette-swatch {
  display: flex;
  width: 32px;
  height: 16px;
  border-radius: 4px;
  overflow: hidden;
  border: 1px solid rgba(100, 116, 139, 0.2);
}
.draw-palette-swatch > div {
  flex: 1;
}
.draw-palette-name {
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 10px;
  color: #64748b;
  flex: 1;
}

/* ── Drift Joystick ──────────────────────── */
.draw-joy-sidebar {
  padding: 12px 16px;
  border-top: 1px solid rgba(100, 116, 139, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}
.draw-joy-label {
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 9px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #475569;
  align-self: flex-start;
}
.draw-joy-pad {
  width: 160px;
  height: 160px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(100, 116, 139, 0.15);
  position: relative;
  cursor: grab;
  touch-action: none;
}
.draw-joy-pad.large {
  width: 160px;
  height: 160px;
}
.draw-joy-pad:active { cursor: grabbing; }
.draw-joy-ring {
  position: absolute;
  inset: 25%;
  border-radius: 50%;
  border: 1px dashed rgba(100, 116, 139, 0.1);
  pointer-events: none;
}
.draw-joy-knob {
  position: absolute;
  top: calc(50% - 10px);
  left: calc(50% - 10px);
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #22d3ee;
  box-shadow: 0 0 10px rgba(34, 211, 238, 0.4);
  pointer-events: none;
  transition: none;
}
.draw-joy-pad.large .draw-joy-knob {
  width: 28px;
  height: 28px;
  top: calc(50% - 14px);
  left: calc(50% - 14px);
  box-shadow: 0 0 20px rgba(34, 211, 238, 0.5);
}
.draw-joy-speed {
  position: absolute;
  bottom: -24px;
  left: 50%;
  transform: translateX(-50%);
